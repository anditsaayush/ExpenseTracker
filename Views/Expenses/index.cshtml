@model IEnumerable<ExpenseTracker.Models.Expense>

@{
    var totalExpenses = Model.Sum(e => e.Amount);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Expenses</h1>
        <p class="text-muted mb-0">Track and manage your spending.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary mt-3 mt-md-0 px-4">
        + Add Expense
    </a>
</div>


<!-- Summary Card -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-1">Total Expenses</p>

                <h3 class="fw-bold mb-0">
                    Rs. @totalExpenses.ToString("N2")
                </h3>
            </div>
        </div>
    </div>
</div>


<!-- Expenses Table -->
<div class="card border-0 shadow-sm">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Recent Expenses</h5>

            <span class="text-muted small">
                @Model.Count() expense(s)
            </span>
        </div>


        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <h5 class="text-muted">No expenses yet</h5>

                <p class="text-muted mb-3">
                    Start tracking your spending by adding your first expense.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    Add Your First Expense
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var expense in Model)
                        {
                            <tr>

                                <td>
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2">
                                        @expense.Category
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-semibold">
                                        Rs. @expense.Amount.ToString("N2")
                                    </span>
                                </td>

                                <td class="text-muted">
                                    @expense.Date.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                           asp-route-id="@expense.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@expense.Id"
                                           class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>